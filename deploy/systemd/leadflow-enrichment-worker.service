[Unit]
Description=LeadFlow AI Asynchronous Enrichment Worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=leadflow
Group=leadflow
WorkingDirectory=/opt/leadflow-ai
EnvironmentFile=/etc/leadflow/leadflow.env

ExecStart=/opt/leadflow-ai/.venv/bin/python workers/enrichment_worker.py

KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/leadflow-ai/logs

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
