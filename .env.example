# Cold Email Outreach System — Environment Configuration
# Copy this file to .env and fill in your values

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.8

# ── Gmail API ────────────────────────────────────────────────────────────────
# Place your OAuth credentials.json in config/credentials/
# Tokens are stored automatically in config/credentials/tokens/
GMAIL_CREDENTIALS_FILE=config/credentials/credentials.json

# ── Google Sheets (Optional) ────────────────────────────────────────────────
# Place your service_account.json in config/credentials/
SHEETS_SERVICE_ACCOUNT_FILE=config/credentials/service_account.json

# ── Email Sending ────────────────────────────────────────────────────────────
DAILY_SEND_LIMIT=50
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=120
MAX_RETRIES=3

# ── Warmup ───────────────────────────────────────────────────────────────────
WARMUP_ENABLED=true
WARMUP_START_LIMIT=10
WARMUP_INCREMENT=5

# ── Follow-Up Timing ────────────────────────────────────────────────────────
FOLLOWUP_1_DAYS=2
FOLLOWUP_2_DAYS=5

# ── Reply Monitoring ────────────────────────────────────────────────────────
REPLY_CHECK_INTERVAL_MINUTES=5

# ── Server & Security ──────────────────────────────────────────────────────────
API_SECRET_KEY="change_this_to_a_random_secure_string_in_production"
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
